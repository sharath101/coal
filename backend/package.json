{
  "name": "@coal/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/dev.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "openapi": "tsx src/scripts/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@coal/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pino": "^10.0.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
