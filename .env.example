# Copy to .env and adjust. Never commit .env. These defaults match docker-compose.yml.

# Backend
DATABASE_URL=postgres://coal:coal@localhost:5432/coal
# The tests create throwaway databases on this server.
TEST_DATABASE_URL=postgres://coal:coal@localhost:5432/postgres
API_PORT=4000
API_HOST=127.0.0.1
# Reverse proxies whose X-Forwarded-For is believed; only ones that overwrite that header.
# Leave empty locally: the website's rewrite passes the browser's header through.
TRUST_PROXY=
LOG_LEVEL=info
# Set to true only behind HTTPS (demo and production).
COOKIE_SECURE=false
SESSION_DAYS=14

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=coal-files
S3_ACCESS_KEY_ID=coal
S3_SECRET_ACCESS_KEY=coal-local-only
S3_FORCE_PATH_STYLE=true
# Local only: create the bucket on start.
S3_CREATE_BUCKET=true

# Filling templates in COAL (fields from records, the document form, the assistant drafting a
# template's sections) is parked until Jayon says how its templates will look. Leave it false: a
# template is then Jayon's Word form as it is, which people fill in Word and upload.
TEMPLATE_FILLING=false
# Demo only, to be removed before the hand-off: an admin account (made by `seed:demo`) that can take
# the place of anyone in one click, without signing out. Leave it false (the default) for anything
# but the demo: off, the admin account can't sign in and nothing can switch people.
ADMIN_SWITCHING=true
# Gotenberg turns Word files into PDFs (docker-compose.yml starts it).
GOTENBERG_URL=http://localhost:3100
# Virus scanning of uploads. Leave empty locally and uploads stay "not scanned" (made-up data only).
# To try it: docker compose --profile scan up -d, then CLAMAV_HOST=localhost. Required in production.
CLAMAV_HOST=
CLAMAV_PORT=3310
# How long an action card (proposal) waits to be confirmed before it expires.
PROPOSAL_EXPIRY_HOURS=72

# Website
COAL_API_URL=http://127.0.0.1:4000


# The assistant. Which provider answers: anthropic, copilot (temporary, below) or none.
AI_PROVIDER=anthropic
# Madhav's Anthropic key, shared with you. Calls are billed and logged under it.
ANTHROPIC_API_KEY=sample
# The workspace that key bills to. Required: the key above isn't tied to one workspace.
ANTHROPIC_WORKSPACE_ID=sample
# Each person's daily spend limit, in US dollars (the day is Indian time).
AI_DAILY_BUDGET_USD=5
# The most tools one reply may use, and how long it may take.
AI_MAX_TOOL_CALLS=20
AI_TURN_TIMEOUT_MS=120000
# The largest file, in megabytes, that may be attached to a message in the chat (a document the
# assistant reads, or a picture it looks at). Up to 100.
AI_UPLOAD_MAX_MB=10
# Override one row of the model table: AI_MODEL_CHAT, AI_MODEL_TITLE, AI_MODEL_DRAFT_WRITE,
# AI_MODEL_TEMPLATE, AI_MODEL_RESEARCH or AI_MODEL_WEB (the web assistant; the research model
# unless set), e.g. AI_MODEL_CHAT=claude-haiku-5-5 (Copilot names its models with dots:
# claude-haiku-5.5)

# Looking things up on the web: the assistant asks a separate web assistant, which sees only the
# question COAL checked, and searches and reads public pages. Anthropic only (Claude's web search and
# web reader may need switching on for the organisation in the Anthropic Console); on Copilot the web
# isn't available. AI_WEB=false turns it off for everyone. Per reply: at most AI_WEB_LOOKUPS_PER_REPLY
# lookups (1 to 3); per lookup: AI_WEB_MAX_SEARCHES searches, AI_WEB_MAX_PAGES pages read in full,
# within AI_WEB_TIMEOUT_MS.
AI_WEB=true
AI_WEB_LOOKUPS_PER_REPLY=2
AI_WEB_MAX_SEARCHES=5
AI_WEB_MAX_PAGES=5
AI_WEB_TIMEOUT_MS=60000

# Research in public sources. All optional: the free keys raise the sources' limits, and NCBI
# (PubMed) and Crossref ask for a contact address. A run sends at most RESEARCH_MAX_SEARCHES queries.
NCBI_API_KEY=
OPENFDA_API_KEY=
RESEARCH_CONTACT_EMAIL=
RESEARCH_MAX_SEARCHES=20

# Temporary (D19): on a laptop whose network blocks the Anthropic API, the GitHub Copilot SDK
# stands in, on your own Copilot licence. A fine-grained token of your own account with the
# "Copilot Requests" permission, and AI_PROVIDER=copilot above. For your own local work only:
# refused in production.
COPILOT_GITHUB_TOKEN=sample